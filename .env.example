# Supabase Configuration (State & Candle Cache)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# Resend API Configuration
RESEND_API_KEY=re_123456789
ALERT_EMAIL_TO=trader@example.com
ALERT_EMAIL_FROM=onboarding@resend.dev

# Stock Pairs to Monitor (Comma separated TICKER_A:TICKER_B)
PAIRS_CONFIG=KO:PEP,V:MA,HD:LOW,XOM:CVX

# Market Hours & Timezone (US Equities default)
MARKET_TIMEZONE=America/New_York
MARKET_OPEN=09:30
MARKET_CLOSE=16:00
IGNORE_MARKET_HOURS=false

# Statistical Strategy Thresholds
Z_SCORE_THRESHOLD=2.5
SUSTAINED_PERIODS=2
ZERO_THRESHOLD=0.25
ROLLING_WINDOW=78

# Rate Limiting (seconds between yfinance calls)
YFINANCE_DELAY_SECONDS=1.0
